# import-linter — 경계 계약 (설계서 §6.2 / S2)
#
# 왜 루트의 별도 파일인가: mypy.ini 와 같은 이유다. 루트 pyproject.toml 은
# .extraction-layout.json 이 예약한 배송 경로라 게이트 설정을 거기 두면 배송이 거부한다.
#
# 실행에 형제 레인이 sys.path 에 필요하다 (이 레인은 혼자 돌지 않는다 — EXTRACTED_FROM.md):
#   SIB="$(cd .. && pwd)/fcc-test-contracts"
#   PYTHONPATH="$PWD:$SIB:$SIB/packages/fcc-test-kernel" lint-imports --no-cache
#
# --no-cache 는 장식이 아니다: 캐시를 쓰면 `.import_linter_cache/` 가 트리에 남는데,
# mypy 와 달리 import-linter 는 자기 캐시에 .gitignore 를 넣지 않는다. 이 레포의
# .gitignore 는 배송이 관리하므로 규칙을 더할 수 없다 — 그래서 플래그로 막는다.
# 게이트(tests/test_architecture_gate_conformance.py)도 같은 플래그로 부른다.
#
# include_external_packages 가 없으면 실행 자체가 거부된다 —
# forbidden_modules 에 외부 패키지(psycopg 등)가 있기 때문이다.

[importlinter]
root_packages =
    fcc_test_platform
include_external_packages = True

# ── 계약 1 — 4층 레이어 ────────────────────────────────────────────────
# 위가 아래를 import 한다. 역방향과 건너뛰는 역방향을 모두 금지한다.
[importlinter:contract:layers]
name = 4-layer architecture (api > infrastructure > application > domain)
type = layers
layers =
    fcc_test_platform.api
    fcc_test_platform.infrastructure
    fcc_test_platform.application
    fcc_test_platform.domain

# ── 계약 2 — 도메인 순수성 ─────────────────────────────────────────────
# 도메인은 웹 프레임워크 · DB 드라이버 · 표 계산 라이브러리를 몰라야 한다.
# 이 계약이 KEPT 인 것이 mypy.ini 가 domain/* 에만 strict 를 거는 근거다.
[importlinter:contract:purity]
name = domain third-party purity
type = forbidden
source_modules =
    fcc_test_platform.domain
forbidden_modules =
    fastapi
    psycopg
    sqlalchemy
    pandas
    openpyxl

# ── 계약 3 — application 의 DB 드라이버 격리 ───────────────────────────
# SQL 은 infrastructure 에서만 나와야 한다. **등재는 0건**이고 계약은 예외 없이
# KEPT 다 — 2026-09-05 에 설계서 S3(DB 어댑터 이전)가 착지했다.
# 착지 후 실측: `Analyzed 213 files, 927 dependencies` · 3 kept, 0 broken.
#
# 무엇이 있었고 어떻게 없앴나. 등재는 착지 직전 실측(211 파일 / 921 의존) 2건이었다:
#
#   ① application.central_project_reference_adapter -> psycopg (l.63)   직접
#      → 모듈을 infrastructure/adapters/driven/ 으로 그대로 옮겼다. 그 어댑터가
#        psycopg 의 JSONB 바인딩(`psycopg.types.json.Jsonb`)을 잡으므로 driven
#        어댑터가 원래 있어야 할 자리였다. 코드 변경 0줄, 위치만 바뀌었다.
#
#      ⚠️ **여기로 옮기면 «application 범위» 봉인 셋의 스캔에서 빠진다.**
#        `test_platform_rbac_membership_audit_fe_p8.py` 의 세 검사가
#        `resolve_repo_artifact(__file__, 'src/application/platform').rglob('*.py')`
#        로 훑는데, driven 은 그 접두사 밖이다. 이번 이동은 손실 0이었다(실측: 옮긴
#        464줄에 audit event_type 토큰 0 · `audit_events` 언급 없음 · role 리터럴 0).
#        그러나 **감사 이벤트나 role 리터럴을 쓰는 어댑터를 여기로 옮기면 조용히
#        스캔 밖으로 나간다.** 그때는 그 세 검사의 범위를 driven 까지 넓혀라 —
#        실측상 지금 넓혀도 방출 집합이 안 변해(등호 유지) 안전하다.
#
#   ② application.runtime_config -> fcc_test_platform.central_db_config (l.26)
#        -> psycopg (l.135)                                             간접
#      → 루트 모듈 하나가 «설정»과 «연결 생성»을 함께 들고 있어 생긴 것이었다.
#        그래서 둘로 갈랐다:
#          · 설정      → fcc_test_platform/central_db_settings.py (드라이버를 모른다)
#          · 연결 생성 → infrastructure/adapters/driven/central_db_connection.py
#        runtime_config 는 이제 설정만 본다. central_db_config 은 **공표된 8개
#        이름을 그대로 다시 내보내는 파사드**로 남는다 — 모노레포의
#        src/progress_expectation_sync_composition.py 가 그 경로에서 세 이름을
#        pip 배포판으로 가져가므로, 분리를 이유로 이름을 없애면 그쪽이 깨진다.
#
#      ⚠️ **`.extraction-layout.json` 의 값은 따라 고치지 «않았다».** 그 장부는
#        살아 있는 해소기의 입력이고(`fcc_test_contracts.common.tree_artifacts`),
#        디렉터리를 해소할 때 접두사 아래 모든 항목의 «목적지 집합»을 만든 뒤
#        후보가 둘이면 `RelocationAmbiguity` 로 거부한다. 한 디렉터리에서 파일
#        하나만 옮기면 그 순간 후보가 둘이 된다 — 실측으로 이 레인의 검사 9곳
#        (6파일)이 한꺼번에 빨개졌다. 모노레포 원본은 이미 삭제돼 그 항목은 순수
#        출처 기록이므로, 장부는 그대로 두고 이동 사실은 여기와 커밋에 적는다.
#
#      ⚠️ 이 위반은 grep 으로 보이지 않았다 — 경유 모듈이 application 밖에 있다.
#        같은 이유로 «한 파일씩 보는» AST 가드로도 원리적으로 안 잡힌다. 그래서
#        이 축은 그래프 도구가 갖는다.
#
# ⚠️ **등재를 다시 늘리지 마라.** tests/test_architecture_gate_conformance.py 의
#    TestNoContractCarriesABaseline 이 세 계약 «모두»에 대해 ignore_imports 의
#    부재를 검사한다(공집합이 바닥이므로 이제 그 축이 더 강하다). 위반이 생겼다면
#    답은 등재가 아니라 코드다 — 아래 broken_contract_guidance 를 보라.
[importlinter:contract:app-no-db]
name = application DB driver isolation
type = forbidden
source_modules =
    fcc_test_platform.application
forbidden_modules =
    psycopg
    sqlalchemy
# 등재 없음(S3 착지). 이 플래그는 «미래»를 위해 켜 둔다 — 누군가 다시 등재를
# 넣는 날, 그 등재가 해소되면 게이트가 스스로 깨져 지우도록 강제한다.
unmatched_ignore_imports_alerting = error
broken_contract_guidance =
    SQL 은 infrastructure 에서만 나온다. 새 위반이면 어댑터를 infrastructure/adapters/driven/ 에
    두고 application 은 domain 의 포트(Protocol)만 잡아라. 설계서 S3 를 보라.
