# ============================================================================
# Local dev:stack runtime env — TEMPLATE (committable; copy to .env.dev-stack.local)
# ============================================================================
#
#   cp apps/web/.env.dev-stack.local.example apps/web/.env.dev-stack.local
#   # then edit the per-machine paths below, and:
#   apps/web/scripts/dev-stack-local.sh --fresh
#
# `.env.dev-stack.local` is gitignored (apps/**/.env.*.local). This `.example`
# is the SSOT for what that file must contain. `dev-stack-local.sh` sources the
# .local copy and passes it through to the 3 uvicorn backends spawned by
# scripts/dev-stack.mjs (session :8000 / headless :8001 / platform :8002), behind
# the Vite gateway (:5173) — mirrors the prod single-origin path-routed topology.
#
# WSL/Linux note: this repo is Windows-first. The venv must live at
# `fcc_test_env/bin/python` so dev-stack.mjs auto-detects it (or set FCC_PYTHON).

# ── Infra (Keycloak IdP) ─────────────────────────────────────────────────────
# Reuse the always-on central Keycloak (fcc-central-keycloak, port 8081) which
# imports the same `fcc-dev` realm — skip dev:stack's own dev IdP boot.
# Unset (or =0) to let dev:stack boot its own docker-compose.idp.yml Keycloak.
FCC_DEV_STACK_SKIP_INFRA=1

# ── Session API (per-machine workbook) ───────────────────────────────────────
# MUST be a COMPLETE workbook (Analyzer Settings + ~17 sheets) — a Test-Plan-only
# sheet crashes session boot. Point this at the plan you actually work on.
FCC_SESSION_EXCEL_PATH="/mnt/c/FCC_mobile_test_automation/dist/<your-test-plan>.xlsx"

# ── Headless API (per-engineer SQLite, auto-created/migrated on first boot) ──
# ⚠️ Creating the file is not seeding it. The capability matrix resolves every
# channel through `frequency_table` in THIS database, so a fresh one makes test
# plan generation refuse with `503 REFERENCE_DATA_NOT_PROVISIONED`. Fill it:
#     python scripts/dev_seed/headless.py     # honours FCC_HEADLESS_DB_PATH
# (the central leg — scripts/dev_seed/central.py — fills platform PostgreSQL;
#  neither leg implies the other, and order between them does not matter.)
FCC_HEADLESS_DB_PATH="/home/<you>/FCC_mobile_test_automation/.dev/headless.db"

# ── Session API runtime dir (writable state root) ────────────────────────────
# Where the session node keeps logs, local state and uploaded workbooks
# (`uploads/workbooks/<sha256>.xlsx`). Unset, SessionApiConfig falls back to the
# process working directory — so a node started from the repository root writes
# those artifacts INTO THE SOURCE TREE. `dev-stack-local.sh` derives
# `<repo>/.dev/session-runtime` when this is empty, so setting it is optional;
# set it to move that state onto another disk.
# FCC_SESSION_RUNTIME_DIR="/home/<you>/FCC_mobile_test_automation/.dev/session-runtime"

# ── Platform API central DSN ─────────────────────────────────────────────────
# The running fcc-central-postgres. Host port + credentials come from your
# infra/central/central.env (defaults shown; example uses host port 15432).
FCC_CENTRAL_DB_URL="postgresql://fcc:fcc-dev-password@127.0.0.1:15432/fcc_central"

# ── OIDC auth — AUTO-DERIVED, do NOT hardcode here ───────────────────────────
# dev-stack.mjs derives every backend OIDC value (issuer / audience / jwks_uri)
# for all three surfaces from the ONE browser-facing SSOT,
# apps/web/public/runtime-config.dev.json (oidcIssuer + oidcClientId), and injects
# them + AUTH_MODE=oidc_jwt at launch — see scripts/derive-oidc-env.mjs. So with
# Keycloak running, project creation works out of the box; there is nothing to set
# here, and copy-pasting issuer/realm/audience literals would only invite drift.
#
# OPT-OUT (per surface, optional): set EITHER of these and the launcher leaves
# that surface alone (no oidc_jwt injected). Use only for quick local dev.
#   * FCC_PLATFORM_ALLOW_INSECURE=1   → cross-engineer reads served WITHOUT auth
#                                       (project CREATION stays refused by design)
#   * FCC_PLATFORM_AUTH_MODE=disabled → fully open platform surface
# (same knobs exist under FCC_HEADLESS_ / FCC_SESSION_ prefixes.)
