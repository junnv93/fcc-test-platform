# Dependencies
node_modules
.pnpm-store

# Build outputs
dist
dist-ssr
build
.vite
# tsc -b emits *.d.ts alongside composite-project entrypoints and
# *.tsbuildinfo cache files — never commit these.
*.d.ts
*.tsbuildinfo
# Codegen output kept gitignored by the dedicated rule below.

# Test outputs
coverage
playwright-report
playwright/.cache
test-results

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
logs/

# OS / Editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.history

# Local env files (runtime-config.json must NEVER be committed — only template.json)
.env
.env.*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Generated TypeScript types (regenerated via `npm run codegen`)
src/api/generated/*.ts
src/api/generated/*.tsx
src/api/generated/*.d.ts
# Keep the directory marker so the path exists before first codegen run
!src/api/generated/.gitkeep

# Lighthouse CI
.lighthouseci

# OpenTelemetry trace logs
otel-traces.json
