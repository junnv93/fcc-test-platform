{
  "name": "@fcc/web",
  "version": "0.1.4",
  "description": "FCC Test Platform production frontend — React + TypeScript + Vite. Sprint S1 scaffold (2026-05-23).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23",
    "npm": ">=10.9"
  },
  "scripts": {
    "predev": "node scripts/write-dev-runtime-config.mjs",
    "dev": "vite",
    "dev:stack": "node scripts/dev-stack.mjs",
    "dev:stack:test-plans": "node scripts/run-test-plans-live-stack.mjs",
    "dev:stack:local": "bash scripts/dev-stack-local.sh",
    "dev:stack:fresh": "bash scripts/dev-stack-local.sh --fresh",
    "check:dev-config": "node scripts/write-dev-runtime-config.mjs --check",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/codegen.mjs --check",
    "measure:bundle": "node scripts/measure-bundle.mjs",
    "measure:fonts": "node scripts/measure-font-assets.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:preflight": "node scripts/playwright-runtime-preflight.mjs",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test --project=chromium-visual",
    "test:e2e:visual:update": "node --input-type=module -e \"if (process.env.CI) { console.error('visual snapshot updates are forbidden in CI'); process.exit(1); }\" && playwright test --project=chromium-visual --update-snapshots",
    "test:e2e:visual:verify": "playwright test --project=chromium-visual",
    "test:e2e:live:test-plans": "node scripts/run-live-e2e.mjs --lane=test-plans",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:grid-poc": "playwright test --config=playwright.grid-poc.config.ts",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "test:e2e:live:reference-data": "node scripts/run-live-e2e.mjs --lane=reference-data",
    "test:e2e:live:chamber-config": "node scripts/run-live-e2e.mjs --lane=chamber-config",
    "test:e2e:live:local-auth": "node scripts/run-local-auth-live-stack.mjs",
    "test:e2e:live:test-plans:docker": "node scripts/run-live-e2e.mjs --lane=test-plans --runtime=docker-server"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-zone": "1.27.0",
    "@opentelemetry/core": "1.27.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.54.0",
    "@opentelemetry/instrumentation": "0.54.0",
    "@opentelemetry/instrumentation-fetch": "0.54.0",
    "@opentelemetry/instrumentation-xml-http-request": "0.54.0",
    "@opentelemetry/sdk-trace-base": "1.27.0",
    "@opentelemetry/sdk-trace-web": "1.27.0",
    "@sentry/browser": "8.40.0",
    "@tanstack/react-query": "5.59.20",
    "@tanstack/react-query-devtools": "5.59.20",
    "@tanstack/react-virtual": "^3.13.26",
    "jose": "^5.10.0",
    "openapi-fetch": "0.13.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "4.1.2",
    "react-router-dom": "6.27.0",
    "web-vitals": "4.2.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lhci/cli": "0.14.0",
    "@playwright/test": "1.48.2",
    "@sentry/types": "^8.40.0",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "4.3.3",
    "eslint": "9.14.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.12.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.4.2",
    "openapi-typescript-helpers": "0.0.15",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.59.4",
    "vite": "5.4.10",
    "vite-plugin-checker": "0.8.0",
    "vite-tsconfig-paths": "5.1.2",
    "vitest": "2.1.4"
  }
}
