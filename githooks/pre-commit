#!/usr/bin/env bash
# Two refusals, in the order they can be answered.
#
#   1. Refuse a commit that lands on a branch this worktree did not claim.
#      Rationale and decision rules: scripts/work_claim_branch_guard.py
#   2. Refuse a commit whose staged paths this worktree's claim owns but had not
#      declared before this change (M-2 declare-before-edit).
#      Rationale and decision rules: scripts/supervisor_preflight.py
#   3. Refuse a commit that mixes an approval artifact (intent.md / spec.md)
#      with code. Rationale: scripts/check_intent_commit_separation.py
#      ⚠️ Added 2026-09-07 **behind** the two above — not replacing them.
#         This hook's own header records why: a transfer that overwrote instead
#         of merging would have silently removed the only blocking gate.
#
# ⚠️ The second check exists here because it existed nowhere else. It was added
# in round 4b so the ordering question could be asked of the INDEX rather than
# only of a commit that already exists — and a sixth independent reviewer then
# measured that no hook, script, or CI job invoked it. A gate a human has to
# remember to type is not a gate; the repository has recorded that shape before.
#
# Fails open on a missing interpreter. Blocking every commit in the repository
# because a virtualenv is absent would be worse than the defect this prevents,
# so the degradation is announced rather than silent.
set -u

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
guard="$repo_root/scripts/work_claim_branch_guard.py"
preflight="$repo_root/scripts/supervisor_preflight.py"
[ -f "$guard" ] || exit 0

python_bin=""
for candidate in \
  "$repo_root/fcc_test_env/bin/python" \
  "$repo_root/fcc_test_env/Scripts/python.exe" \
  "$(command -v python3 2>/dev/null)" \
  "$(command -v python 2>/dev/null)"
do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    python_bin="$candidate"
    break
  fi
done

if [ -z "$python_bin" ]; then
  echo "work-claim guard: no Python interpreter found — branch and ordering checks skipped." >&2
  exit 0
fi

"$python_bin" "$guard" check || exit $?

# ⚠️ Resolved from the worktree binding, not from a path typed by the caller —
# a hook that needs to be told which claim it is under would be as unreachable as
# the check it replaces. An unbound worktree skips this and says so; the branch
# guard above already refuses that case on its own terms.
if [ -f "$preflight" ]; then
  "$python_bin" "$preflight" --check-staged-ordering || exit $?
fi

# ── 축 3: 승인 아티팩트와 코드의 혼합 (2026-09-07) ────────────────────────────
# 앞의 두 축과 **독립**이다 — 하나를 면제해도 나머지가 막는다.
# ⚠️ 우회를 «일부러 시끄럽게» 만든다. 조용한 우회는 게이트가 없는 것과 같다.
separation="$repo_root/scripts/check_intent_commit_separation.py"
if [ "${FCC_ALLOW_MIXED_INTENT_COMMIT:-0}" = "1" ]; then
  echo "intent 분리 게이트: FCC_ALLOW_MIXED_INTENT_COMMIT=1 — 건너뛴다." >&2
elif [ -f "$separation" ]; then
  "$python_bin" "$separation" --root "$repo_root" </dev/null || exit $?
fi

exit 0
