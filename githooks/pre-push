#!/bin/sh
# 이 레인이 **오늘 실제로 막는** 게이트.
#
# ⚠️ **2026-09-06 정정.** 이 자리는 *"GitHub Actions 가 러너를 배정받지 못하는
# 동안(2026-08-30 실측), 서버측에서 무엇도 막지 않는다"* 고 적고 있었다. **이
# 저장소에 대해서는 낡았다** — 이 레인의 CI 는 돈다. 실측 2026-09-06: PR #128 의
# `lane-check` 가 실제 러너에서 1분 43초 걸려 **pass** 했다(run 34029290461).
#
# 러너 부재가 참인 곳은 **모노레포**(`FCC_mobile_test_automation`)다. 그쪽은
# 비공개라 계정 축(결제/한도)에 걸려 있고, 이 레인과 형제 레인은 공개라 표준
# 러너가 무료다. 「CI 가 없다」는 문장은 레포마다 다르게 참이고, 어느 레포인지
# 없이 유통되면 틀린다.
#
# 그래도 이 훅은 남는다. 사유가 「서버측이 아무것도 안 막는다」에서 「서버측보다
# **먼저** 막는다」로 바뀔 뿐이다 — push 전에 로컬에서 잡으면 CI 한 바퀴가 줄고,
# 러너가 다시 사라져도 이 축은 남는다.
#
# ⚠️ 이것은 실수 방지층(guardrail)이지 방어층이 아니다. 설치는 clone 마다
#    opt-in 이고(`git config core.hooksPath githooks`), `--no-verify` 한 번이면
#    사라진다. 이 문장이 사라지면 다음 사람이 이것을 강제라고 믿는다.
#    진짜 강제는 러너가 돌아오고 branch protection 이 이 검사를 required 로
#    거는 날에 생긴다 — 그날까지 이것은 **가장 값싼 근사**다.
#
# 우회: FCC_SKIP_LANE_CHECK=1 git push   (그리고 왜 우회했는지 적어라)
#       ⚠️ ref 삭제에는 «더 이상 필요 없다» — 아래 축 0 이 알아본다.
#
# ── 2026-09-03: 여기에 **두 번째 축**을 덧붙였다 (모노레포에서 이관) ────────────
# 아래 레인 검사는 그대로 **차단**하고, 그 앞에 base 신선도 **조언**이 하나 붙는다.
# 두 축은 독립이다: 하나가 조용해도 나머지가 말한다.
#
# ⚠️ 이관하면서 **덮어쓰지 않았다.** 모노레포판 pre-push 는 조언 전용이라 항상
# exit 0 이다 — 그대로 복사했으면 이 저장소의 **유일한 차단 게이트가 조용히
# 사라졌을 것이다.** 사본을 뜨는 것이 아니라 합치는 이유가 그것이다.
#
# 신선도 축이 차단하지 않는 이유는 모노레포판 그대로다: 낡은 브랜치를 작업 중에
# 푸시하는 것은 정당하다. 실제 비용은 머지 시점에 발생하고 그 자리의 게이트는
# `scripts/merge_readiness_guard.py merge <N>` 이다.
#
# ── 2026-09-07: **축 0** 을 앞에 붙였다 — 삭제 push 는 판정 대상이 없다 ────────
#
# 이 훅은 그날까지 stdin 을 «전혀 읽지 않았고», 그래서 ref 삭제
# (`git push --delete <branch>`)와 트리를 미는 push 를 구별하지 못했다.
# 삭제에는 검사할 트리가 없는데 전량 시험(3,000+건)이 돌았고, 인터프리터에
# pytest 가 없으면 「pytest 가 시작조차 못했다」로 막혔다 — 즉 실패 모양이
# 「도구가 없다」인데 메시지는 「네가 방금 깨뜨렸다」로 읽힌다.
# **부재와 회귀가 같은 빨강**이다.
#
# ⚠️ 그리고 그것이 더 나쁜 이유: 정당한 경로(머지 뒤 브랜치 정리)에 우회를
#    강제하면 `FCC_SKIP_LANE_CHECK=1` 이 손에 익고, 그 습관은 **트리를 미는
#    push 로 옮겨간다.** 우회를 정상화하는 게이트는 게이트가 아니다.
#
# 판정은 **local sha 가 전부 0 인지**로 한다. ref 이름 필드(`(delete)`)는
# git 판본에 따라 흔들리므로 쓰지 않는다.
set -eu

# stdin 을 **한 번만** 읽어 변수에 담는다. 뒤의 축들이 같은 것을 봐야 하고,
# git 은 이 스트림을 한 번만 준다.
#
# ⚠️ 단 **stdin 이 터미널이면 읽지 않는다.** `$(cat)` 은 EOF 를 기다리므로,
#    사람이 `bash githooks/pre-push origin URL` 을 그냥 치면 **거기서 멈춘다.**
#    그러면 아래 규칙 ③(「ref 를 하나도 못 봤으면 건너뛰지 않는다」)이 겨냥한
#    바로 그 시나리오에 **도달조차 못 한다.**
#
#    ⚠️ 이 멈춤은 **재현하지 못했다** — 이 환경에 `/dev/tty` 가 없고,
#    `script` 로 만든 pty 는 마스터 쪽이 즉시 EOF 라 `cat` 이 막히지 않았다.
#    즉 아래 가드의 근거는 «관측»이 아니라 «비대칭»이다: 가드는 공짜이고,
#    없을 때의 대가는 사람이 훅을 손으로 돌리다 멈추는 것이다.
#    (형제 세션 fcc-delivery-final-97 이 제기, 2026-09-07)
if [ -t 0 ]; then
    _refs=''
else
    _refs=$(cat || true)
fi

_deleting_only=1
_saw_a_ref=0
# ⚠️ **파이프를 쓰지 마라.** `echo "$_refs" | while read` 는 `while` 을 서브셸에서
#    돌려 아래 두 변수가 소실된다. 그러면 `_saw_a_ref` 가 0 으로 남아 삭제
#    건너뛰기가 **조용히 멈추고** 게이트가 다시 삭제 push 를 막는다 —
#    fail-safe 방향이라 아무도 눈치채지 못한다. here-string 이어야 한다.
#    봉인: tests/test_pre_push_distinguishes_a_deletion.py
while read -r _lref _lsha _rref _rsha; do
    [ -z "${_lsha:-}" ] && continue
    _saw_a_ref=1
    case "$_lsha" in *[!0]*) _deleting_only=0 ;; esac
done <<EOF
$_refs
EOF

# ⚠️ ref 를 하나도 «못 봤으면» 건너뛰지 않는다. 훅을 손으로 부르거나 stdin 이
#    비어 있는 경우가 그것이고, 그때 건너뛰면 그 실패 모양이 «초록»이라
#    자기 자신을 드러내지 못한다.
if [ "$_saw_a_ref" = "1" ] && [ "$_deleting_only" = "1" ]; then
    echo "pre-push: ref 삭제 push 다 — 검사할 트리가 없다. 레인 검사 «해당 없음»." >&2
    exit 0
fi

# ── 축 1 (조언 전용, 절대 차단 안 함): base 신선도 ────────────────────────────
# ⚠️ 자식에게 `</dev/null` 을 준다. 이 훅의 stdin 은 이미 소비됐고, 자식이
#    그것을 읽으려 하면 «오늘은» 빈 것을 볼 뿐이지만 내일은 다르다.
#    「오늘의 스크립트가 안 읽는다」가 아니라 **그 부류 전체**에 면역을 준다.
_root_for_advice=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -n "${_root_for_advice:-}" ] && [ -f "$_root_for_advice/scripts/merge_readiness_guard.py" ]; then
    for _py in "$_root_for_advice/.venv/bin/python" "$(command -v python3 2>/dev/null || true)"; do
        if [ -n "$_py" ] && [ -x "$_py" ]; then
            "$_py" "$_root_for_advice/scripts/merge_readiness_guard.py" advise </dev/null || true
            break
        fi
    done
fi

# ── 축 2 (차단): 레인 검사 ────────────────────────────────────────────────────

if [ "${FCC_SKIP_LANE_CHECK:-0}" = "1" ]; then
    echo "pre-push: FCC_SKIP_LANE_CHECK=1 — 레인 검사를 건너뛴다." >&2
    exit 0
fi

root=$(git rev-parse --show-toplevel)
python=${FCC_LANE_CHECK_PYTHON:-python3}

if [ ! -f "$root/scripts/lane_check.py" ]; then
    echo "pre-push: scripts/lane_check.py 가 없다 — 게이트를 돌리지 못한다." >&2
    echo "          이것은 통과가 아니다. 상자가 온전한지 확인하라." >&2
    exit 1
fi

# 워크플로와 **같은 진입점**이다. 여기에 pytest 를 인라인하면 두 게이트가 갈라진다.
if ! "$python" "$root/scripts/lane_check.py" --root "$root" </dev/null; then
    cat >&2 <<'MSG'

pre-push: 막았다 — 관측된 실패 집합이 이 상자가 선언한 것과 다르다.

  위 목록이 무엇이 어긋났는지 이름으로 말한다.
    · "선언에 없는 실패"  → 네가 방금 깨뜨렸다. 고쳐라.
    · "선언됐는데 통과"    → 고쳐진 것이다. 선언을 줄여라:
                             python3 scripts/lane_check.py --write-baseline

  ⚠️ 기준선을 관측값으로 덮어써서 초록을 만들지 마라. 그것은 검사를 끄는 것이다.

MSG
    exit 1
fi
