  "owner_repository": "fcc-test-platform",
  "provenance_policy": {
    "placeholder_convention": "angle-bracket tokens (<token>) mark unresolved template values produced by suggested-command templates and the live-workflow values skeleton",
    "real_evidence_requirement": "evidence manifests collected from a live environment never contain placeholder tokens; the cutover readiness gate emits placeholder_evidence_value for any hit and the completion audit refuses to declare completion",
    "self_report_requirement": "the bundle assembler honors a manifest's own validated/issues fields when present and only defaults to validated=true / issues=[] when the manifest omits them"
  },
  "receipt_policy": {
    "metadata_suffix": ".receipt.json",
    "receipts_never_satisfy_required_evidence_keys": true,
    "resume_metadata_is_not_evidence": true,
    "resume_requires_current_catalog_validator_pass": true,
    "resume_requires_matching_output_size_and_sha256": true
  },
