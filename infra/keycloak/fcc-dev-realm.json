{
  "realm": "fcc-dev",
  "displayName": "FCC Test Platform (dev)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "realm": [
      { "name": "viewer", "description": "Read-only access to sessions / reports." },
      { "name": "operator", "description": "Start/stop measurement sessions." },
      { "name": "admin", "description": "Full administrative access." }
    ]
  },
  "groups": [
    {
      "name": "viewers",
      "realmRoles": ["viewer"],
      "attributes": { "permissions": ["session:read", "session:events", "platform:read"] }
    },
    {
      "name": "operators",
      "realmRoles": ["viewer", "operator"],
      "attributes": { "permissions": ["session:read", "session:events", "session:control", "platform:read", "platform:claim", "platform:sample-write", "platform:reference-write", "platform:chamber-config-write"] }
    },
    {
      "name": "admins",
      "realmRoles": ["viewer", "operator", "admin"],
      "attributes": { "permissions": ["session:read", "session:events", "session:control", "platform:read", "platform:claim", "platform:admin", "platform:sample-write", "platform:reference-write", "platform:chamber-config-write", "headless:read", "headless:control", "report_automation:read", "report_automation:control", "test_plan:read", "test_plan:author"] }
    },
    {
      "name": "system-admins",
      "realmRoles": ["admin"],
      "attributes": { "permissions": ["platform:sample-hard-delete"] }
    }
  ],
  "users": [
    {
      "username": "viewer",
      "email": "viewer@fcc.test",
      "firstName": "View",
      "lastName": "Only",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "viewer", "temporary": false }],
      "groups": ["viewers"]
    },
    {
      "username": "operator",
      "email": "operator@fcc.test",
      "firstName": "Op",
      "lastName": "Erator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "operator", "temporary": false }],
      "groups": ["operators"]
    },
    {
      "username": "admin",
      "email": "admin@fcc.test",
      "firstName": "Ad",
      "lastName": "Min",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "groups": ["admins"]
    }
  ],
  "clients": [
    {
      "clientId": "fcc-platform-frontend",
      "name": "FCC Platform Frontend (PKCE)",
      "description": "Public client used by apps/web. PKCE only — no client secret.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5173/auth/callback",
        "http://127.0.0.1:5173/auth/callback",
        "http://localhost:8080/auth/callback",
        "http://127.0.0.1:8080/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:8080",
        "http://127.0.0.1:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://127.0.0.1:5173/*##http://localhost:8080/*##http://127.0.0.1:8080/*"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": ["basic", "profile", "email", "roles"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "fcc-permissions-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "permissions",
            "claim.name": "permissions",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true"
          }
        },
        {
          "name": "fcc-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true"
          }
        },
        {
          "name": "fcc-frontend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fcc-platform-frontend",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "fcc-chamber-node",
      "name": "FCC Chamber Node (machine token)",
      "description": "Machine token for native chamber PCs (client_credentials). Emits permissions=platform:chamber + aud=fcc-platform-frontend. Secret from FCC_CHAMBER_CLIENT_SECRET env (never raw in file).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${FCC_CHAMBER_CLIENT_SECRET}",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "fcc-chamber-permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "permissions",
            "claim.value": "platform:chamber",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "fcc-chamber-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fcc-platform-frontend",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "fcc-staging-cli",
      "name": "FCC Staging CLI (direct grant, human RBAC)",
      "description": "Direct-grant client for staging automation; mints real USER tokens (permissions from group membership, not hardcoded). Secret from FCC_STAGING_CLI_SECRET env.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "secret": "${FCC_STAGING_CLI_SECRET}",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "fcc-staging-cli-permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "permissions",
            "claim.name": "permissions",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "multivalued": "true"
          }
        },
        {
          "name": "fcc-staging-cli-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "multivalued": "true"
          }
        },
        {
          "name": "fcc-staging-cli-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fcc-platform-frontend",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
