# FCC Central Hub — Web SPA static + same-origin API gateway image (B1/P13).
#
# Multi-stage: build the Vite SPA with Node, then serve the static bundle from
# nginx, which ALSO acts as the browser's same-origin API gateway (it
# reverse-proxies /headless and /platform to the API containers — see
# nginx.conf). The runtime config (API/IdP endpoints) is NOT baked in: the
# entrypoint script GENERATES `/runtime-config.js` from env via `envsubst` at
# container start (30-runtime-config.sh), so the same image points at any
# environment (dev / central / prod) without a rebuild and no endpoint can drift.
#
#   build stage : npm ci + npm run build  ->  /web/dist
#   serve stage : nginx static + SPA fallback + API gateway (infra/central/nginx.conf)

# --- build stage ---------------------------------------------------------
# Node 22 LTS — matches apps/web `engines.node = ">=22.13 <23"` (the accepted
# Node 22.13 LTS frontend runtime policy; see node-runtime-policy-closure). The
# `22` alpine tag tracks the latest 22.x (>=22.13, <23), so `npm ci`/`npm run
# build` run on the policy runtime instead of a stale Node 20.
FROM node:22-alpine AS build
# ⚠️ The build tree MIRRORS the repository layout (`/app/apps/web` +
# `/app/packages/...`), it is not flattened to `/web`. `apps/web`'s lockfile
# links `@fcc/api-artifacts` as `../../packages/api-artifacts`, and that relative
# path only lands correctly when the web root sits TWO levels below the tree
# root. At `/web` the `../..` collapses at the filesystem root (`/..` is `/`), so
# Arborist's own key for the link target stops matching the directory it
# resolves to and `npm ci` dies inside `loadVirtual` (measured 2026-09-01 —
# see the COPY comment below). Moving the WORKDIR down two levels is what fixes
# it; putting the target directory in place is NOT enough, that was measured too.
WORKDIR /app/apps/web

# Dependency layer first (package manifests only) for build-cache reuse.
#
# ⚠️ The link target comes FIRST, before `npm ci` — not with the source copy
# below. `apps/web/package.json` carries `@fcc/api-artifacts: file:../../packages/
# api-artifacts`, so the lockfile holds a `link: true` entry whose target is
# `../../packages/api-artifacts` = `/app/packages/api-artifacts` from this WORKDIR.
# `npm ci` resolves every lockfile link before installing anything, and when the
# target directory is absent Arborist throws inside `loadVirtual` — which npm
# CATCHES and reports as `EUSAGE: can only install with an existing
# package-lock.json`. That message names the wrong file: the lockfile is present
# and valid (measured 2026-09-01: lockfileVersion 3, 931 entries). Diagnosing it
# requires the HEAD of `--loglevel=silly`, where the real line reads
# `loadVirtual TypeError: Cannot read properties of undefined (reading
# 'extraneous')`. Keep this COPY above `npm ci` or a clean build cannot run at all.
COPY packages/api-artifacts/ /app/packages/api-artifacts/
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

# Codegen BEFORE build. `apps/web/src/api/generated/*.ts` is gitignored
# (apps/web/.gitignore), so a fresh checkout carries only `.gitkeep` and
# `npm run build` fails on ~100 cascading TS errors whose single root cause is
# three missing `./generated/*-api.types` modules. CI regenerates them
# (frontend-build.yml: npm ci -> npm run codegen -> build); this image must do
# the same or the central stack cannot be built from a clean clone at all.
#
# codegen.mjs imports `../../../packages/api-artifacts/index.mjs` relative to
# `apps/web/scripts/`, which resolves to `/app/packages/api-artifacts` under this
# WORKDIR. That tree is already in the image — it had to land before `npm ci`
# above — so it is not copied twice.
COPY apps/web/ ./
RUN npm run codegen && npm run build

# --- serve stage ---------------------------------------------------------
FROM nginx:1.27-alpine AS serve
# SPA-aware nginx config (history fallback + static asset caching).
COPY infra/central/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
# runtime-config.js is GENERATED at start from env (no endpoint is baked in).
# The template + generator derive every browser-facing endpoint from the same
# port SSOT compose publishes with (central.env.example), so the same image
# points at any environment without a rebuild and no port can drift.
COPY infra/central/runtime-config.central.js.template /etc/nginx/runtime-config.central.js.template
COPY infra/central/docker-entrypoint.d/30-runtime-config.sh /docker-entrypoint.d/30-runtime-config.sh
RUN chmod +x /docker-entrypoint.d/30-runtime-config.sh
# CSP connect-src widening — derive the IdP + WS origins from the SAME env vars
# 30-runtime-config.sh uses, so the prod meta CSP (which assumes an https IdP)
# also permits the central stack's http Keycloak + ws gateway origins. Runs
# after 30 (nginx executes /docker-entrypoint.d/*.sh in lexical order).
COPY infra/central/docker-entrypoint.d/31-csp-connect-src.sh /docker-entrypoint.d/31-csp-connect-src.sh
RUN chmod +x /docker-entrypoint.d/31-csp-connect-src.sh
EXPOSE 80

# ── Deployment revision (배포 드리프트 게이트, 2026-08-23) ────────────────────
# Same contract as Dockerfile.api — the full rationale lives there. Kept LAST so the
# `npm ci` / `npm run build` layers above keep their cache, and defaulted EMPTY
# so a build without GIT_REVISION reports UNKNOWN rather than a plausible lie.
ARG GIT_REVISION=""
LABEL org.opencontainers.image.revision="${GIT_REVISION}"
