# ============================================================================
# FCC Central Hub — docker-compose environment SSOT (B1/P13)
# ============================================================================
#
# Copy to `infra/central/central.env` and adjust per deployment:
#   cp infra/central/central.env.example infra/central/central.env
#   docker compose -f infra/docker-compose.central.yml --env-file infra/central/central.env up -d
#
# Every port / credential / endpoint the central stack needs lives HERE — the
# compose file references these names with ${VAR:-default} so there are no
# hardcoded ports or secrets in the YAML. The FCC_* names match the Python
# runtime-config SSOT (application/headless/runtime_config.py,
# application/platform/runtime_config.py, application/headless/central_db_config.py)
# and drift is sealed by tests/test_central_docker_compose.py.
#
# SINGLE-SOURCE DERIVATIONS (no value is written twice):
#   * The web SPA runtime-config (browser-facing API/IdP endpoints) is GENERATED
#     at web-container start from PUBLIC_HOST + the published ports below
#     (infra/central/runtime-config.central.js.template via envsubst). Changing a
#     port here changes the SPA endpoint with it — there is no second JS to edit.
#   * The platform-api central DSN (FCC_CENTRAL_DB_URL) is ASSEMBLED by compose
#     from the POSTGRES_* values below, so a rotated credential can never leave a
#     stale DSN. Do NOT set FCC_CENTRAL_DB_URL here (see note in the DB section).

# --- Published host ports ---------------------------------------------------
# These are the SINGLE port SSOT: compose publishes them AND the web SPA
# runtime-config derives its browser-facing endpoints from them.
WEB_PORT=8080
HEADLESS_API_PORT=8001
PLATFORM_API_PORT=8002
KEYCLOAK_PORT=8081
POSTGRES_PORT=5432

# --- Web SPA runtime endpoints (browser-facing) -----------------------------
# SAME-ORIGIN GATEWAY: the browser talks to ONE origin — the web container at
# PUBLIC_HOST:WEB_PORT. nginx reverse-proxies /headless,/platform to the API
# containers, so the SPA's apiBaseUrl/wsBaseUrl are PUBLIC_HOST:WEB_PORT (not the
# API host ports) and no CORS is needed. runtime-config.js is generated from
# these at web-container start, so the SPA endpoints are derived — never
# hardcoded — from this single source.
# NOTE: the Keycloak realm import (infra/keycloak/fcc-dev-realm.json) statically
# allows PUBLIC_HOST:WEB_PORT (default localhost:8080) as a redirect/web origin.
# If you change PUBLIC_HOST or WEB_PORT, add the matching origin to that realm.
#
# ALWAYS-ON central-PC deploy: set PUBLIC_HOST to the central PC's FIXED LAN IP
# (e.g. 172.30.1.10) so chamber-node PCs and tester browsers on the LAN reach it
# and the OIDC token `iss` is deterministic. Then add http://<that-ip>:${WEB_PORT}
# to the realm redirect/web origins — see infra/central/ONPREM_DEPLOYMENT.md.
PUBLIC_HOST=localhost

# --- Transport policy -------------------------------------------------------
# ⚠ DELIBERATE SPEC DEVIATION — leave UNSET unless you have no other option.
# The SPA refuses to boot when its API/IdP endpoints are plain http:// on a
# non-loopback host. That rule exists because RFC 6749 §3.1/§3.2 require TLS
# ("MUST require the use of TLS") for the authorization and token endpoints and
# RFC 9700 forbids sending authorization responses over unencrypted connections.
# Set this to `true` ONLY for a closed on-prem LAN deployment that cannot obtain
# a TLS certificate, and only with the risk accepted in writing: bearer tokens
# then travel in clear text and anyone on the network path can replay them.
# Remove the line the moment TLS is available — the secure default will then
# catch a mis-typed endpoint instead of silently accepting it.
# Default `false` = the SPA refuses to boot on plain http, which is what you
# want the moment TLS exists. Set to `true` only for the closed-LAN case above.
ALLOW_INSECURE_TRANSPORT=false
# OIDC realm/client are shared tokens between the browser issuer and the API
# issuers (referenced as ${OIDC_REALM} in both — one source, no drift).
OIDC_REALM=fcc-dev
OIDC_CLIENT_ID=fcc-platform-frontend

# --- PostgreSQL (central DB) — credential SSOT ------------------------------
# These three values are the ONLY place the DB credentials live. The platform-api
# DSN is assembled from them by compose (see note below).
# ⚠ PRODUCTION: the defaults below are DEMO values. For the always-on central PC
# you MUST rotate POSTGRES_PASSWORD (and the secrets further down) to real values
# before exposing the stack on the LAN — see infra/central/ONPREM_DEPLOYMENT.md.
POSTGRES_USER=fcc
POSTGRES_PASSWORD=fcc-dev-password
POSTGRES_DB=fcc_central

# --- Keycloak (OIDC IdP) ----------------------------------------------------
# ⚠ PRODUCTION: rotate KEYCLOAK_ADMIN_PASSWORD — `admin/admin` is a DEMO default.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Client secrets substituted into the realm import (${ENV} placeholders in
# infra/keycloak/fcc-dev-realm.json — secrets are never stored raw in that file).
#   FCC_CHAMBER_CLIENT_SECRET  — fcc-chamber-node machine token (platform:chamber)
#   FCC_STAGING_CLI_SECRET     — fcc-staging-cli direct-grant client (human RBAC)
# Dev defaults below; staging/prod MUST rotate (chamber-token-rbac runbook).
FCC_CHAMBER_CLIENT_SECRET=fcc-chamber-dev-secret
# 중앙 → 챔버 노드 Session API 기계 신분증(운영자 판정 2026-09-01). realm 의
# fcc-central-session client 시크릿이며, 노드가 요구하는 session:control 을 담은
# 토큰을 중앙이 이 자격으로 발급받는다. fcc-chamber-node 의 반대 방향이다.
FCC_CENTRAL_SESSION_CLIENT_SECRET=fcc-central-session-dev-secret
FCC_STAGING_CLI_SECRET=fcc-staging-cli-dev-secret

# --- Headless API (FCC_HEADLESS_* SSOT) -------------------------------------
# Auth mode: disabled | trusted_headers | oidc_jwt | local_jwt (see auth_config.py).
FCC_HEADLESS_AUTH_MODE=oidc_jwt
# OIDC split-horizon (assembled in compose — do NOT set here):
#   FCC_HEADLESS_OIDC_ISSUER   = http://${PUBLIC_HOST}:${KEYCLOAK_PORT}/realms/${OIDC_REALM}
#       (browser-facing — matches the token `iss` the SPA obtains; validated by the API)
#   FCC_HEADLESS_OIDC_JWKS_URI = http://keycloak:8080/realms/${OIDC_REALM}/protocol/openid-connect/certs
#       (internal — the API fetches signing keys over the compose network)
# Both derive from the port SSOT above, so there is nothing to set per env here.
# SQLite-backed headless runtime DB inside the container (volume-backed).
FCC_HEADLESS_DB_PATH=/data/headless/headless.fcc.db

# --- Platform read API (FCC_PLATFORM_* + FCC_CENTRAL_* SSOT) ----------------
FCC_PLATFORM_AUTH_MODE=oidc_jwt
# FCC_PLATFORM_OIDC_ISSUER / FCC_PLATFORM_OIDC_JWKS_URI: same split-horizon as
# headless above — assembled in compose from the port SSOT, not set here.
# ⚠️ 이 값은 라벨이 아니라 `providers.provider_id` **자연키**이고, 계약 SSOT
# (`fcc_test_contracts.headless.api_contracts.DEFAULT_PROVIDER_METADATA`) 가
# 소유한다. 여기에 아무 문자열이나 적으면 인증을 다 통과한 뒤 참조 번들에서
# `404 unknown provider_id` 로 나타나 **인증 문제로 오독**된다(실측 2026-09-01,
# 개발 PC — 예시 env 가 `unlicensed` 를 실었는데 같은 저장소의 런북 S4(a) 는
# `fcc-unlicensed-conducted` 를 INSERT 한다. 출하되는 예시가 출하되는 런북이
# 등록하지 않는 provider 를 지목하고 있었다).
# 바꿔야 하면 손으로 열지 말고 `scripts/configure_central_provider_id.py` 로 —
# 중앙 세션 uuid 가 `uuid5(ns, f'{provider_id}:{로컬 세션번호}')` 라서 측정이
# 유입된 뒤 바꾸면 같은 측정이 다른 세션으로 중복 유입된다.
# 값 동등성 봉인: tests/test_central_docker_compose.py::TestProviderIdentityValue
FCC_CENTRAL_PROVIDER_ID=fcc-unlicensed-conducted
# --- Inbound rate limiting (2026-07-19) --------------------------------------
# 미설정 = 활성(secure by default). 기본값 SSOT 는
# src/domain/services/rate_limit_policy.py 이며 아래는 그 기본값의 재진술이다.
# 끄려면 명시적으로 FCC_{PLATFORM,HEADLESS}_RATE_LIMIT_ENABLED=0 (kill-switch).
# 게이트웨이(nginx) 의 limit_req 는 이와 별개의 방어층 — 둘 다 유효하다.
FCC_PLATFORM_RATE_LIMIT_REQUESTS=120
FCC_PLATFORM_RATE_LIMIT_WINDOW_SECONDS=60
# 인증 면제 /platform/metrics 전용(더 좁은) 예산.
FCC_PLATFORM_RATE_LIMIT_METRICS_REQUESTS=30
FCC_PLATFORM_RATE_LIMIT_METRICS_WINDOW_SECONDS=60
# 이 스택은 headless surface 도 같은 게이트웨이 뒤에서 서비스한다. 위 주석이
# FCC_{PLATFORM,HEADLESS} 를 함께 언급하므로, headless 쪽도 명시해 두 surface 의
# 예산이 파일에서 한눈에 대조되게 한다(두 값이 다르면 그것은 의도된 차이여야 한다).
FCC_HEADLESS_RATE_LIMIT_REQUESTS=120
FCC_HEADLESS_RATE_LIMIT_WINDOW_SECONDS=60
FCC_HEADLESS_RATE_LIMIT_METRICS_REQUESTS=30
FCC_HEADLESS_RATE_LIMIT_METRICS_WINDOW_SECONDS=60
# --- peer 축 신뢰 hop (2026-08-22) -------------------------------------------
# ⚠️ 위 예산이 "한 사람당" 을 뜻하려면 서버가 **실 클라이언트 주소**를 봐야 한다.
# nginx 뒤에서는 그것이 자동이 아니다 — uvicorn 은 `FORWARDED_ALLOW_IPS` 에 적힌
# 출처에서 온 요청에 한해서만 X-Forwarded-For 를 읽고, 기본값은 127.0.0.1 이다.
# 미설정이면 전원이 **버킷 하나**를 공유한다(그리고 아무 오류도 나지 않는다).
#
# 그 값은 compose 가 `web`(nginx) 에 준 **정적 주소**이고, 아래 두 변수가 그
# 주소와 그것이 사는 대역을 정한다. 둘은 함께 움직인다 — 주소는 대역 안이어야 하고
# 네트워크/게이트웨이/브로드캐스트 주소일 수 없다(테스트가 산술로 판정한다).
#
# 바꿔야 하는 경우: `docker compose up` 이
#   Error response from daemon: invalid pool request: Pool overlaps with other one
# 로 실패한다 = 이 호스트가 이미 172.31.240.0/24 를 쓰고 있다. 범인을 이름으로 찾으려면:
#   docker network ls -q | xargs -r docker network inspect -f '{{.Name}} {{json .IPAM.Config}}'
# ⚠️ 세 값은 **함께** 옮긴다 — 주소는 대역 안이어야 하고, `.1`(브리지 게이트웨이)·
# 네트워크·브로드캐스트 주소일 수 없다. 하나만 바꾸면 compose 가 exit 1 로 거부한다.
#
# CENTRAL_APP_DYNAMIC_RANGE 는 도커가 **자동 배정**에 쓰는 하위 풀이고,
# CENTRAL_PROXY_IP 는 반드시 그 **밖**이어야 한다(그러지 않으면 컨테이너가 늘었을 때
# 자동 배정이 프록시 주소를 먼저 가져가고 `web` 이 `Address already in use` 로
# 실패한다 — 실측된 결함이다).
#
# ⚠️ **`aux_addresses` 로 예약하지 말 것.** aux 예약은 «자동 배정만 피해라» 가 아니라
# «그 주소는 사용 중이다» 라서 **명시적 정적 요청까지 거부**한다 — 즉 `web` 이 아예
# 뜨지 못한다(적대 평가 3R 실측 + 독립 재현). 좁혀야 하는 것은 자동 배정 풀이다.
#CENTRAL_APP_SUBNET=172.31.240.0/24
#CENTRAL_APP_DYNAMIC_RANGE=172.31.240.128/25
#CENTRAL_PROXY_IP=172.31.240.10
#
# 실 클라이언트(시험원 PC·챔버 PC)가 사는 대역. **주석 처리하지 말 것** — 이 값이
# 비어 있으면 "신뢰 대상이 실 클라이언트를 삼켰다" 를 잡는 유일한 검사가 꺼진다.
# 그 오설정의 증상은 오류가 아니라 "공격자가 헤더에 적은 값이 그대로 신원이 되는 것"
# 이라 조용하다. ⚠️ 값은 **배포마다 다르다** — 아래는 예시이므로 실제 사내망 대역으로
# 바꿔라. 틀린 값을 적으면 검사가 덜 유용해질 뿐 정상 배포를 막지는 않는다.
FCC_CENTRAL_CLIENT_RANGES=10.206.0.0/16
# NOTE: FCC_CENTRAL_DB_URL is intentionally NOT set here. compose ASSEMBLES it
# for platform-api from the POSTGRES_* credential SSOT above (flat interpolation):
#   postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# so rotating POSTGRES_PASSWORD/USER/DB here can never leave the DSN stale. To
# point at an EXTERNAL managed Postgres, set FCC_CENTRAL_DB_URL directly in the
# platform-api environment mapping (or a compose override file) — not here.

# ─────────────────────────────────────────────────────────────────────────────
# 로컬 로그인 (identity axis, 2026-08-21) — 평문 HTTP 로 노출한다면 필수
#
# ⚠️ 중앙 PC 를 https 없이 http://<IP>:8080 으로 노출하면 **Keycloak 로그인은 원리적으로
# 불가능하다**. 브라우저는 PKCE 가 쓰는 crypto.subtle 을 보안 컨텍스트(https 또는
# localhost)에서만 제공하고, 그 API 는 설정으로 되살릴 수 없다. ALLOW_INSECURE_TRANSPORT
# 는 프론트의 전송 검증만 통과시킬 뿐 이것을 고치지 않으며, 그 조합은 이제 프론트가
# **부팅에서 거부**한다.
#
# 아래 둘은 **반드시 함께** 바꾼다. 하나만 바꾸면 브라우저와 API 가 "로그인이 무엇인지"에
# 대해 서로 다른 답을 갖는다.
#   FCC_PLATFORM_AUTH_MODE=local_jwt   (API 가 발행/검증)
#   WEB_AUTH_MODE=local                (SPA 가 자체 로그인 폼을 띄운다)
#
# 기본값은 둘 다 OIDC 이므로 이 블록을 건드리지 않으면 기존 배포는 그대로다.
# 평문 HTTP 배포에서는 아래 WEB_AUTH_MODE 를 local 로 바꾸고 FCC_PLATFORM_AUTH_MODE 를
# 함께 local_jwt 로 선언한다.
WEB_AUTH_MODE=oidc
#FCC_PLATFORM_AUTH_MODE=local_jwt

# HS256 서명 키. ⚠️ **32바이트 미만이면 부팅을 거부한다** (RFC 7518 §3.2 — HS256 키는
# 해시 출력 길이 이상이어야 한다). 짧은 키는 아무 증상도 만들지 않으므로 — 로그인도 되고
# 토큰도 발급된다 — 시작할 때 거부하지 않으면 아무도 알아채지 못한다.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#FCC_PLATFORM_LOCAL_JWT_SECRET=
# 토큰의 iss / aud. ⚠️ 접속 주소와 무관해도 되고, **users.issuer 와도 다른 축**이다
# (이 둘은 "토큰을 누가 서명했나", users.issuer 는 "신원을 누가 발급했나").
#FCC_PLATFORM_LOCAL_JWT_ISSUER=https://fcc-platform.internal/auth
#FCC_PLATFORM_LOCAL_JWT_AUDIENCE=fcc-platform-web
# 액세스 15분 / 리프레시 7일 (EMS 와 동일). 비우면 이 기본값.
#FCC_PLATFORM_LOCAL_JWT_TTL_SECONDS=900
#FCC_PLATFORM_LOCAL_JWT_REFRESH_TTL_SECONDS=604800

# 최초 관리자. ⚠️ **없으면 아무도 로그인할 수 없다** — users 표는 비어서 시작하고 모든
# 쓰기 경로가 인증된 principal 을 요구한다. 로컬 사용자가 **하나도 없을 때만** 생성되므로,
# 이미 관리자가 있으면 이 값을 바꾸고 재시작해도 아무 일도 일어나지 않는다(그렇지 않으면
# 이것은 부트스트랩이 아니라 비밀번호 재설정 백도어다).
#
# ⚠️ 초기 비밀번호는 이 파일과 배포 로그에 남는다. 그래서 첫 로그인이 비밀번호 변경
# 화면으로 **강제 이동**하고, 바꾸기 전에는 다른 어떤 화면도 열리지 않는다.
# 정책: 8자 이상 · UTF-8 72바이트 이하(한글 24자) · 복잡도 규칙 없음(NIST SP 800-63B).
#FCC_PLATFORM_BOOTSTRAP_ADMIN_EMAIL=
#FCC_PLATFORM_BOOTSTRAP_ADMIN_PASSWORD=

# ── ⚠️ 여기서 끝이 아니다 (2026-08-22) ────────────────────────────────────────
# 위까지만 설정하면 **로그인은 되는데 headless 화면이 전부 401** 이고, 평문 배포에서는
# **화면이 아예 뜨지 않는다**. 셋을 함께 선언한다.
#
# 1) headless 도 같은 토큰을 검증한다 — SPA 가 /headless 와 /platform 에 같은 bearer 를
#    붙이기 때문이다. 값 셋은 위 platform 것과 **같아야 한다**.
#FCC_HEADLESS_AUTH_MODE=local_jwt
#FCC_HEADLESS_LOCAL_JWT_SECRET=
#FCC_HEADLESS_LOCAL_JWT_ISSUER=https://fcc-platform.internal/auth
#FCC_HEADLESS_LOCAL_JWT_AUDIENCE=fcc-platform-web
#
# 2) 평문 HTTP 로 노출한다면 SPA 의 전송 검증을 열어야 한다. 없으면 런타임 설정 검증이
#    던지고 화면이 통째로 안 뜬다(로그인 이전 문제다).
#ALLOW_INSECURE_TRANSPORT=true
#
# 3) ⚠️ **정합 확인** — 위 값들은 서로 짝이어야 하고, 그 판정은 기계가 한다:
#      python3 scripts/check_auth_mode_pairing.py --env-file infra/central/central.env
#    0 = 정합 · 1 = 어긋남(고칠 값을 알려준다) · 2 = 판정할 값이 없음(통과 아님)
