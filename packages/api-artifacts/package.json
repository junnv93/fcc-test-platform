{
  "name": "@fcc/api-artifacts",
  "version": "0.1.4",
  "description": "Shared FCC API contract artifacts (session/headless/platform OpenAPI 3.1 + central DB schema) bundled as a repo-split-ready package. Mirror of the canonical docs/ SSOT; consumed by codegen.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13 <23"
  },
  "main": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./manifest.json": "./manifest.json",
    "./artifacts/*": "./artifacts/*"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "manifest.json",
    "artifacts",
    "scripts/sync.mjs",
    "README.md"
  ],
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "pack:check": "npm pack --dry-run --json"
  }
}
